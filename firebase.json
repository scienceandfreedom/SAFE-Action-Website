{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "node_modules",
      "functions/**",
      "crawler/**",
      "scripts/**",
      "docs/**",
      ".git/**",
      ".claude/**",
      "*.py",
      "*.log",
      "*.md",
      "data/ballotpedia_candidates_cache.json",
      "data/openstates_cache.json",
      "data/candidate_enrichment_cache.json",
      "data/removed_emails_audit.json",
      "data/removed_candidates.json",
      "preview-*.html",
      "command-center-preview.html",
      "design-overhauls.html",
      "data/records.fixture.json"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/pledges/list",
        "function": "pledges"
      },
      {
        "source": "/api/pledges/confirm",
        "function": "pledges"
      },
      {
        "source": "/api/pledges/submit",
        "function": "pledges"
      },
      {
        "source": "/pledge",
        "destination": "/quiz.html"
      },
      {
        "regex": "^/(?i:a[klrz]|c[aot]|d[ce]|fl|ga|hi|i[adln]|k[sy]|la|m[adeinost]|n[cdehjmvy]|o[hkr]|pa|ri|s[cd]|t[nx]|ut|v[at]|w[aivy])$",
        "destination": "/state.html"
      },
      {
        "source": "/api/list/send",
        "function": "mailingList"
      },
      {
        "source": "/api/list/unsubscribe",
        "function": "mailingList"
      },
      {
        "source": "/api/list/confirm",
        "function": "mailingList"
      },
      {
        "source": "/api/list/subscribe",
        "function": "mailingList"
      },
      {
        "source": "/join",
        "destination": "/join.html"
      },
      {
        "source": "/candidates/:slug",
        "destination": "/candidate.html"
      },
      {
        "source": "/record/:slug",
        "destination": "/record.html"
      },
      {
        "source": "/admin",
        "destination": "/admin.html"
      },
      {
        "source": "/volunteer",
        "destination": "/volunteer.html"
      },
      {
        "source": "/volunteer/nda",
        "destination": "/nda.html"
      },
      {
        "source": "/api/districts",
        "function": "districts"
      },
      {
        "source": "/api/volunteer/apply",
        "function": "volunteerApply"
      },
      {
        "source": "/api/admin/volunteers/**",
        "function": "adminVolunteers"
      },
      {
        "source": "/api/volunteer/nda/lookup",
        "function": "volunteerSignNda"
      },
      {
        "source": "/api/volunteer/*/nda/sign",
        "function": "volunteerSignNda"
      },
      {
        "source": "/api/actions/track",
        "function": "trackAction"
      },
      {
        "source": "/api/donate/checkout",
        "function": "createCheckout"
      },
      {
        "source": "/dashboard",
        "destination": "/dashboard.html"
      },
      {
        "source": "/about",
        "destination": "/about.html"
      },
      {
        "source": "/donate",
        "destination": "/donate.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(self)"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://maps.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' ws://127.0.0.1:4455 ws://localhost:4455 https://www.gstatic.com https://*.googleapis.com https://*.firebaseio.com https://firestore.googleapis.com https://*.cloudfunctions.net wss://*.firebaseio.com; frame-src https://js.stripe.com https://accounts.google.com"
          }
        ]
      },
      {
        "source": "data/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/feed",
        "destination": "/tracker",
        "type": 301
      },
      {
        "source": "/feed.html",
        "destination": "/tracker",
        "type": 301
      },
      {
        "source": "/elections",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/elections.html",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/press",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/press.html",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/updates",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/updates.html",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/intelligence",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/intelligence.html",
        "destination": "/outreach",
        "type": 301
      },
      {
        "source": "/pledge.html",
        "destination": "/pledge",
        "type": 301
      },
      {
        "source": "/quiz",
        "destination": "/pledge",
        "type": 301
      },
      {
        "source": "/quiz.html",
        "destination": "/pledge",
        "type": 301
      }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  }
}